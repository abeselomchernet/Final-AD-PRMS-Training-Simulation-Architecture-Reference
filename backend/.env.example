# ------------------------------------------------------------------------------
# AD-PRMS Future Live Production Cutover Environment Template (Django 5.x + DRF)
# NOTE: These variables are NOT needed for Office Test & Training Mode on Node.
# Configure these only when deploying the containerized Django + PostgreSQL stack
# in backend/docker-compose.prod.yml.
# ------------------------------------------------------------------------------

# Frontend External API Binding (optional — leave unset for built-in Office SQLite Mode)
VITE_APP_MODE="production"
VITE_API_BASE_URL="https://api.prms.example.et"
VITE_WS_BASE_URL="wss://api.prms.example.et"
VITE_VAPID_PUBLIC_KEY="CHANGE_ME_VAPID_PUBLIC_KEY"

# Django 5.x Production Backend
DJANGO_SETTINGS_MODULE="config.settings.prod"
DJANGO_SECRET_KEY="CHANGE_ME_LONG_RANDOM_SECRET"
DJANGO_DEBUG="False"
DJANGO_ALLOWED_HOSTS="prms.example.et,api.prms.example.et"
CORS_ALLOWED_ORIGINS="https://prms.example.et"
CSRF_TRUSTED_ORIGINS="https://prms.example.et"
FIELD_ENCRYPTION_KEY="CHANGE_ME_FERNET_32_BYTE_BASE64_KEY"

# PostgreSQL 16 & Redis 7
DATABASE_URL="postgres://adprms:CHANGE_ME_DB_PASSWORD@postgres:5432/adprms"
REDIS_URL="redis://redis:6379/0"

# Private Object Storage (s3 | gcs)
STORAGE_BACKEND="s3"
AWS_STORAGE_BUCKET_NAME="adprms-private-evidence"
AWS_S3_REGION_NAME="eu-west-1"
AWS_S3_ENDPOINT_URL=""
GS_BUCKET_NAME="adprms-private-evidence"

# Background Web Push (VAPID)
VAPID_PUBLIC_KEY="CHANGE_ME_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="CHANGE_ME_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:ops@adprms.example.et"

# Live Ethiopian Payment Gateways
ARIFPAY_API_KEY="CHANGE_ME_ARIFPAY_KEY"
ARIFPAY_WEBHOOK_SECRET="CHANGE_ME_ARIFPAY_WEBHOOK_SECRET"
ARIFPAY_BASE_URL="https://gateway.arifpay.org/api"
TELEBIRR_FABRIC_APP_ID="CHANGE_ME_TELEBIRR_APP_ID"
TELEBIRR_APP_SECRET="CHANGE_ME_TELEBIRR_APP_SECRET"
TELEBIRR_MERCHANT_CODE="CHANGE_ME_MERCHANT_CODE"
TELEBIRR_PRIVATE_KEY_PEM=""
TELEBIRR_PUBLIC_KEY_PEM=""
TELEBIRR_BASE_URL="https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway"

# Live Ethiopian SMS Gateway (sandbox | afromessage | geezsms | ethiotelecom)
SMS_PROVIDER="sandbox"
SMS_API_KEY="CHANGE_ME_SMS_API_KEY"
SMS_SENDER_ID="ADPRMS"

# Fiscal Tax Guardrail (MUST remain False until ERCA + Licensed Adviser Verified)
ENABLE_LIVE_TAX_INVOICING="False"
