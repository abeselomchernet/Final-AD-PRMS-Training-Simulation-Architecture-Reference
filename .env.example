# GEMINI_API_KEY: Required for Gemini AI API calls (server-side proxy only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet or Express server is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client uses anon key; RLS enforces owner isolation)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional Django Production API & WebSocket Endpoints
VITE_APP_MODE="training"
VITE_API_BASE_URL=""
VITE_WS_BASE_URL=""
VITE_VAPID_PUBLIC_KEY=""

# Express / Node Server Controls
PORT="3000"
HOST="0.0.0.0"
OFFICE_DB_PATH=""
OFFICE_SESSION_SECRET=""
ARIFPAY_WEBHOOK_SECRET=""
TELEBIRR_PUBLIC_KEY_PEM=""
ALLOWED_VITE_HOSTS=""

# Django Production Backend Settings
DJANGO_ENV="dev"
DJANGO_SECRET_KEY=""
DJANGO_DEBUG="False"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DATABASE_URL=""
REDIS_URL=""
FIELD_ENCRYPTION_KEY=""

# Standalone MCP Service & Internal Bridge Controls (Server-Only — Never expose to browser or VITE_)
MCP_INTERNAL_BRIDGE_SECRET=""
MCP_INTERNAL_BRIDGE_SECRET_PREVIOUS=""
MCP_PORT="3100"
MCP_BIND_HOST="127.0.0.1"
MCP_PUBLIC_HOST=""
MCP_RESOURCE_URI="http://127.0.0.1:3100/mcp"
MCP_ALLOW_LOCAL_DEV_TOKEN="false"
MCP_PUBLIC_TUNNEL_ENABLED="false"
MCP_EXPRESS_BASE_URL="http://127.0.0.1:3000"
MCP_LOCAL_STDIO_UID=""
MCP_LOCAL_STDIO_CLIENT_ID=""

