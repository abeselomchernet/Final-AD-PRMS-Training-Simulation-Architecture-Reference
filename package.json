{
  "name": "ad-prms-prototype",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && npm run build:server && npm run build:mcp",
    "build:frontend": "vite build --outDir dist/client --emptyOutDir",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:mcp": "esbuild services/mcp/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp-server.js",
    "mcp:dev": "tsx services/mcp/src/index.ts",
    "mcp:stdio": "tsx services/mcp/src/index.ts --transport=stdio",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "clean": "rimraf dist server.js test-results playwright-report coverage",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "record:demo": "node scripts/record-amharic-demo.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "d3": "^7.9.2",
    "dompurify": "^3.5.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "jose": "^6.2.18",
    "jsqr": "^1.4.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-window": "^2.5.4",
    "recharts": "^3.10.1",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
